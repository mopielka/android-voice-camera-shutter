<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Debug-only: lets `adb shell am broadcast` fire the shutter so the
         accessibility path can be verified without involving the microphone.
         Never shipped in release, where an exported receiver would be a hole. -->
    <application>
        <receiver
            android:name=".debug.TestShutterReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="dev.opielka.voiceshutter.TEST_SHUTTER" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
